# Copy this file to .env and fill in real values. Never commit .env.

# ---- Anthropic API (required) ----
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
AGENT_MODEL=claude-sonnet-5

# ---- Database (same DB as the PHP app — see includes/config.php) ----
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=bmi_monitor

# ---- ML service (see ../ml_service) ----
ML_SERVICE_URL=http://127.0.0.1:5001

# ---- SMTP for agent-sent alert emails (optional — alerts are skipped,
#      not fatal, if left blank). Same idea as SMTP_* in includes/config.php ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BMI Monitor
